{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeploymentState",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        1
      ],
      "type": "integer"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "active": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "version": {
          "type": "string"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "profile_read": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Inclusive ordered schema range"
        },
        "database_read": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Inclusive ordered schema range"
        }
      },
      "required": [
        "commit",
        "database_read",
        "environment_id",
        "manifest_digest",
        "profile_read",
        "version"
      ],
      "additionalProperties": false
    },
    "previous": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "version": {
              "type": "string"
            },
            "environment_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "manifest_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "profile_read": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Inclusive ordered schema range"
            },
            "database_read": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "Inclusive ordered schema range"
            }
          },
          "required": [
            "commit",
            "database_read",
            "environment_id",
            "manifest_digest",
            "profile_read",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "highest_sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "active",
    "generation",
    "highest_sequence",
    "previous",
    "schema"
  ],
  "additionalProperties": false
}
